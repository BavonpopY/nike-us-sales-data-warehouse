    <worksheet name='WS_Pric_Margin_Leakage_Bar'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Nike US Sales Datasets+' name='federated.17r0a8p1un4zs613b0brn1ctnf5g' />
          </datasources>
          <datasource-dependencies datasource='federated.17r0a8p1un4zs613b0brn1ctnf5g'>
            <column caption='Margin Leakage Amount' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_2266411232124933]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Units Sold] * ([Original Price] - [Current Price]) * (1 - [Operating Margin])' />
            </column>
            <column caption='Price Band' datatype='string' name='[Calculation_2266411232477191]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Current Price] &lt;= 5000 THEN &apos;$0 - $5,000&apos;&#13;&#10;ELSEIF [Current Price] &lt;= 10000 THEN &apos;$5,001 - $10,000&apos;&#13;&#10;ELSEIF [Current Price] &lt;= 15000 THEN &apos;$10,001 - $15,000&apos;&#13;&#10;ELSE &apos;&gt;$15,000&apos;&#13;&#10;END' />
            </column>
            <column caption='Discount Rate' datatype='real' default-format='p0%' name='[Calculation_2266411286298644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND([Discount %] / 100, 2)' />
            </column>
            <column datatype='integer' name='[Current Price]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.00%' name='[Discount %]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.00%' name='[Operating Margin]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Original Price]' role='measure' type='quantitative' />
            <column datatype='string' name='[Product Name]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Units Sold]' role='measure' type='quantitative' />
            <column-instance column='[Product Name]' derivation='None' name='[none:Product Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2266411232124933]' derivation='Sum' name='[sum:Calculation_2266411232124933:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2266411286298644]' derivation='Sum' name='[sum:Calculation_2266411286298644:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.17r0a8p1un4zs613b0brn1ctnf5g].[Action (Price Band)]'>
            <groupfilter function='level-members' level='[Calculation_2266411232477191]' user:ui-action-filter='[Action7_C374ABB37A8D49CF8187BA152891A4A8]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.17r0a8p1un4zs613b0brn1ctnf5g].[none:Product Name:nk]'>
            <groupfilter count='15' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([Calculation_2266411232124933])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:Product Name:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <computed-sort column='[federated.17r0a8p1un4zs613b0brn1ctnf5g].[none:Product Name:nk]' direction='DESC' using='[federated.17r0a8p1un4zs613b0brn1ctnf5g].[sum:Calculation_2266411232124933:qk]' />
          <slices>
            <column>[federated.17r0a8p1un4zs613b0brn1ctnf5g].[none:Product Name:nk]</column>
            <column>[federated.17r0a8p1un4zs613b0brn1ctnf5g].[Action (Price Band)]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='mark'>
            <encoding attr='color' field='[federated.17r0a8p1un4zs613b0brn1ctnf5g].[sum:Calculation_2266411286298644:qk]' max='1.6' min='0.3' palette='red_gold_10_0' type='interpolated' />
          </style-rule>
        </style>
        <panes>
