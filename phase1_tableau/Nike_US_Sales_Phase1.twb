      <aliases enabled='yes' />
      <column caption='Brand (nike 2020 04 13 cleaned.csv)' datatype='string' name='[Brand (nike_2020_04_13_cleaned.csv)]' role='dimension' type='nominal' />
      <column caption='Profit Density' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_2266411231539201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Operating Profit]) / SUM([Units Sold])' />
      </column>
      <column caption='Weighted Rating' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2266411231752195]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(ZN([Rating]) * ZN([Reviews])) / ZN(SUM([Reviews]))' />
      </column>
      <column caption='Margin Leakage Amount' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_2266411232124933]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Units Sold] * ([Original Price] - [Current Price]) * (1 - [Operating Margin])' />
      </column>
      <column caption='Price Band' datatype='string' name='[Calculation_2266411232477191]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Current Price] &lt;= 5000 THEN &apos;$0 - $5,000&apos;&#13;&#10;ELSEIF [Current Price] &lt;= 10000 THEN &apos;$5,001 - $10,000&apos;&#13;&#10;ELSEIF [Current Price] &lt;= 15000 THEN &apos;$10,001 - $15,000&apos;&#13;&#10;ELSE &apos;&gt;$15,000&apos;&#13;&#10;END' />
      </column>
      <column caption='Simulated Operating Profit' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_2266411232559112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Operating Profit] * (1 + [Parameters].[Parameter 2266411320746008])' />
      </column>
      <column caption='Profit Gap' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_2266411232698377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Operating Profit] * [Parameters].[Parameter 2266411320746008]' />
      </column>
      <column caption='State Profit Contribution %' datatype='real' name='[Calculation_2266411246788618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Operating Profit]) / SUM({ SUM([Operating Profit]) })' />
      </column>
      <column caption='City Rank' datatype='integer' name='[Calculation_2266411246854155]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='RANK(SUM([Operating Profit]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Scatter X Dynamic' datatype='real' name='[Calculation_2266411279527952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2266411279061007] = &apos;Units Sold&apos; THEN &#13;&#10;    SUM([Units Sold])&#13;&#10;ELSE &#13;&#10;    AVG([Operating Margin]) * 100&#13;&#10;END' />
      </column>
      <column caption='Channel Margin Variance' datatype='real' default-format='p0.00%' name='[Calculation_2266411279626257]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Operating Margin] - { FIXED [Sales Method] : AVG([Operating Margin]) }' />
      </column>
      <column caption='Discount Rate' datatype='real' default-format='p0%' name='[Calculation_2266411286298644]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND([Discount %] / 100, 2)' />
      </column>
      <column caption='Rating Bin' datatype='string' name='[Calculation_2266411307458582]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Rating] &gt;= 4.5 THEN &apos;4.5 - 5.0 Stars (Excellent)&apos;&#13;&#10;ELSEIF [Rating] &gt;= 4.0 THEN &apos;4.0 - 4.4 Stars (Good)&apos;&#13;&#10;ELSEIF [Rating] &gt;= 3.5 THEN &apos;3.5 - 3.9 Stars (Average)&apos;&#13;&#10;ELSE &apos;Below 3.5 Stars (Poor)&apos;&#13;&#10;END' />
      </column>
      <column caption='Action Quadrant' datatype='string' name='[Calculation_2266411332988957]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF { FIXED [Product Name] : SUM([Operating Profit]) } &gt;= { FIXED : MEDIAN({ FIXED [Product Name] : SUM([Operating Profit]) }) } &#13;&#10;   AND { FIXED [Product Name] : AVG([Operating Margin]) } &gt;= { FIXED : MEDIAN({ FIXED [Product Name] : AVG([Operating Margin]) }) } &#13;&#10;THEN &apos;1. Scale Up (Star)&apos;&#13;&#10;&#13;&#10;ELSEIF { FIXED [Product Name] : SUM([Operating Profit]) } &gt;= { FIXED : MEDIAN({ FIXED [Product Name] : SUM([Operating Profit]) }) } &#13;&#10;   AND { FIXED [Product Name] : AVG([Operating Margin]) } &lt; { FIXED : MEDIAN({ FIXED [Product Name] : AVG([Operating Margin]) }) } &#13;&#10;THEN &apos;2. Protect Margin (Cash Cow)&apos;&#13;&#10;&#13;&#10;ELSEIF { FIXED [Product Name] : SUM([Operating Profit]) } &lt; { FIXED : MEDIAN({ FIXED [Product Name] : SUM([Operating Profit]) }) } &#13;&#10;   AND { FIXED [Product Name] : AVG([Operating Margin]) } &gt;= { FIXED : MEDIAN({ FIXED [Product Name] : AVG([Operating Margin]) }) } &#13;&#10;THEN &apos;3. Optimize Volume (Opportunity)&apos;&#13;&#10;&#13;&#10;ELSE &apos;4. Divest / Re-evaluate (Risk)&apos;&#13;&#10;END' />
      </column>
      <column caption='Product Health Score' datatype='real' name='[Calculation_2266411333455902]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;  (&#13;&#10;    ( { FIXED [Product Name] : AVG([Operating Margin]) } - { MIN({ FIXED [Product Name] : AVG([Operating Margin]) }) } )&#13;&#10;    /&#13;&#10;    ( { MAX({ FIXED [Product Name] : AVG([Operating Margin]) }) } - { MIN({ FIXED [Product Name] : AVG([Operating Margin]) }) } )&#13;&#10;  ) * 0.5&#13;&#10;  +&#13;&#10;  (&#13;&#10;    ( { FIXED [Product Name] : ZN(AVG([Rating])) } - { MIN({ FIXED [Product Name] : ZN(AVG([Rating])) }) } )&#13;&#10;    /&#13;&#10;    ( { MAX({ FIXED [Product Name] : ZN(AVG([Rating])) }) } - { MIN({ FIXED [Product Name] : ZN(AVG([Rating])) }) } )&#13;&#10;  ) * 0.5&#13;&#10;) * 100' />
      </column>
      <column caption='Strategic Recommendation' datatype='string' name='[Calculation_2266411337928736]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2266411332988957] = &apos;1. Scale Up (Star)&apos; THEN &apos;อัดงบการตลาด ดันยอดขาย และขยายช่องทางจัดจำหน่าย Online/Outlet เพิ่มเติม&apos;&#13;&#10;ELSEIF [Calculation_2266411332988957] = &apos;2. Protect Margin (Cash Cow)&apos; THEN &apos;ทบทวนโปรโมชัน ลดการแจกส่วนลด (Discount) และควบคุมต้นทุนการขนส่ง&apos;&#13;&#10;ELSEIF [Calculation_2266411332988957] = &apos;3. Optimize Volume (Opportunity)&apos; THEN &apos;ผลักดันการมองเห็น (Visibility) ปรับปรุงแคมเปญเพื่อดึงดันยอดขายขึ้น&apos;&#13;&#10;ELSE &apos;พิจารณาปรับลดสต็อก (Divest) หรือจัดแคมเปญ Clear-Stock ก่อนกระทบกำไร&apos;&#13;&#10;END' />
      </column>
      <column caption='Top 1 Filter' datatype='boolean' name='[Calculation_2266411342065697]' role='measure' type='nominal'>
        <calculation class='tableau' formula='INDEX() = 1'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
