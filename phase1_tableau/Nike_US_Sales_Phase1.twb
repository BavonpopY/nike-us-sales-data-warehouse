            <column-instance column='[Units Sold]' derivation='Sum' name='[sum:Units Sold:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.17r0a8p1un4zs613b0brn1ctnf5g].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.17r0a8p1un4zs613b0brn1ctnf5g].[avg:Operating Margin:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.17r0a8p1un4zs613b0brn1ctnf5g].[avg:Calculation_2266411333455902:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.17r0a8p1un4zs613b0brn1ctnf5g].[avg:Rating:qk]&quot;' />
