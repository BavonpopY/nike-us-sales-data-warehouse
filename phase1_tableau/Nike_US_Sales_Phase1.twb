    <worksheet name='WS_Exec_Strategic_Action_Matrix'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Nike US Sales Datasets+' name='federated.17r0a8p1un4zs613b0brn1ctnf5g' />
          </datasources>
          <datasource-dependencies datasource='federated.17r0a8p1un4zs613b0brn1ctnf5g'>
            <column caption='Action Quadrant' datatype='string' name='[Calculation_2266411332988957]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF { FIXED [Product Name] : SUM([Operating Profit]) } &gt;= { FIXED : MEDIAN({ FIXED [Product Name] : SUM([Operating Profit]) }) } &#13;&#10;   AND { FIXED [Product Name] : AVG([Operating Margin]) } &gt;= { FIXED : MEDIAN({ FIXED [Product Name] : AVG([Operating Margin]) }) } &#13;&#10;THEN &apos;1. Scale Up (Star)&apos;&#13;&#10;&#13;&#10;ELSEIF { FIXED [Product Name] : SUM([Operating Profit]) } &gt;= { FIXED : MEDIAN({ FIXED [Product Name] : SUM([Operating Profit]) }) } &#13;&#10;   AND { FIXED [Product Name] : AVG([Operating Margin]) } &lt; { FIXED : MEDIAN({ FIXED [Product Name] : AVG([Operating Margin]) }) } &#13;&#10;THEN &apos;2. Protect Margin (Cash Cow)&apos;&#13;&#10;&#13;&#10;ELSEIF { FIXED [Product Name] : SUM([Operating Profit]) } &lt; { FIXED : MEDIAN({ FIXED [Product Name] : SUM([Operating Profit]) }) } &#13;&#10;   AND { FIXED [Product Name] : AVG([Operating Margin]) } &gt;= { FIXED : MEDIAN({ FIXED [Product Name] : AVG([Operating Margin]) }) } &#13;&#10;THEN &apos;3. Optimize Volume (Opportunity)&apos;&#13;&#10;&#13;&#10;ELSE &apos;4. Divest / Re-evaluate (Risk)&apos;&#13;&#10;END' />
            </column>
            <column caption='Product Health Score' datatype='real' name='[Calculation_2266411333455902]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;  (&#13;&#10;    ( { FIXED [Product Name] : AVG([Operating Margin]) } - { MIN({ FIXED [Product Name] : AVG([Operating Margin]) }) } )&#13;&#10;    /&#13;&#10;    ( { MAX({ FIXED [Product Name] : AVG([Operating Margin]) }) } - { MIN({ FIXED [Product Name] : AVG([Operating Margin]) }) } )&#13;&#10;  ) * 0.5&#13;&#10;  +&#13;&#10;  (&#13;&#10;    ( { FIXED [Product Name] : ZN(AVG([Rating])) } - { MIN({ FIXED [Product Name] : ZN(AVG([Rating])) }) } )&#13;&#10;    /&#13;&#10;    ( { MAX({ FIXED [Product Name] : ZN(AVG([Rating])) }) } - { MIN({ FIXED [Product Name] : ZN(AVG([Rating])) }) } )&#13;&#10;  ) * 0.5&#13;&#10;) * 100' />
            </column>
            <column datatype='real' default-format='p0.00%' name='[Operating Margin]' role='measure' type='quantitative' />
            <column datatype='real' name='[Operating Profit]' role='measure' type='quantitative' />
            <column datatype='string' name='[Product Name]' role='dimension' type='nominal' />
            <column datatype='real' name='[Rating]' role='measure' type='quantitative' />
            <column-instance column='[Operating Margin]' derivation='Avg' name='[avg:Operating Margin:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2266411332988957]' derivation='None' name='[none:Calculation_2266411332988957:nk]' pivot='key' type='nominal' />
            <column-instance column='[Product Name]' derivation='None' name='[none:Product Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2266411333455902]' derivation='Sum' name='[sum:Calculation_2266411333455902:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Operating Profit]' derivation='Sum' name='[sum:Operating Profit:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.17r0a8p1un4zs613b0brn1ctnf5g].[Action (Action Quadrant,Product Name)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action12_6B0E0E59AE394FF09DB34B5DA57F4298]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[Calculation_2266411332988957]' />
              <groupfilter function='level-members' level='[Product Name]' />
            </groupfilter>
          </filter>
          <filter class='quantitative' column='[federated.17r0a8p1un4zs613b0brn1ctnf5g].[sum:Operating Profit:qk]' included-values='non-null' />
          <slices>
            <column>[federated.17r0a8p1un4zs613b0brn1ctnf5g].[sum:Operating Profit:qk]</column>
            <column>[federated.17r0a8p1un4zs613b0brn1ctnf5g].[Action (Action Quadrant,Product Name)]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <color column='[federated.17r0a8p1un4zs613b0brn1ctnf5g].[none:Calculation_2266411332988957:nk]' />
              <size column='[federated.17r0a8p1un4zs613b0brn1ctnf5g].[sum:Calculation_2266411333455902:qk]' />
              <lod column='[federated.17r0a8p1un4zs613b0brn1ctnf5g].[none:Product Name:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.17r0a8p1un4zs613b0brn1ctnf5g].[avg:Operating Margin:qk]</rows>
        <cols>[federated.17r0a8p1un4zs613b0brn1ctnf5g].[sum:Operating Profit:qk]</cols>
      </table>
      <simple-id uuid='{6DC34A6A-F587-4E17-8D89-3B32CAA39B7A}' />
