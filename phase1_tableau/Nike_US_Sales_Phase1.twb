    <worksheet name='WS_Feed_Rating_Discount_Heatmap'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Nike US Sales Datasets+' name='federated.17r0a8p1un4zs613b0brn1ctnf5g' />
          </datasources>
          <datasource-dependencies datasource='federated.17r0a8p1un4zs613b0brn1ctnf5g'>
            <column caption='Discount Rate' datatype='real' default-format='p0%' name='[Calculation_2266411286298644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND([Discount %] / 100, 2)' />
            </column>
            <column caption='Rating Bin' datatype='string' name='[Calculation_2266411307458582]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Rating] &gt;= 4.5 THEN &apos;4.5 - 5.0 Stars (Excellent)&apos;&#13;&#10;ELSEIF [Rating] &gt;= 4.0 THEN &apos;4.0 - 4.4 Stars (Good)&apos;&#13;&#10;ELSEIF [Rating] &gt;= 3.5 THEN &apos;3.5 - 3.9 Stars (Average)&apos;&#13;&#10;ELSE &apos;Below 3.5 Stars (Poor)&apos;&#13;&#10;END' />
            </column>
            <column datatype='real' default-format='p0.00%' name='[Discount %]' role='measure' type='quantitative' />
            <column datatype='real' default-format='p0.00%' name='[Operating Margin]' role='measure' type='quantitative' />
            <column datatype='string' name='[Product ID]' role='dimension' type='nominal' />
            <column datatype='string' name='[Product Name]' role='dimension' type='nominal' />
            <column datatype='real' name='[Rating]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2266411286298644]' derivation='Avg' name='[avg:Calculation_2266411286298644:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Operating Margin]' derivation='Avg' name='[avg:Operating Margin:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Product ID]' derivation='CountD' name='[ctd:Product ID:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2266411286298644]' derivation='None' name='[none:Calculation_2266411286298644:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_2266411307458582]' derivation='None' name='[none:Calculation_2266411307458582:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.17r0a8p1un4zs613b0brn1ctnf5g].[Action (Product Name)]'>
            <groupfilter function='level-members' level='[Product Name]' user:ui-action-filter='[Action8_97B274007FE04A7CA2C4C12F7A9F472F]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='quantitative' column='[federated.17r0a8p1un4zs613b0brn1ctnf5g].[avg:Calculation_2266411286298644:qk]' included-values='non-null' />
          <manual-sort column='[federated.17r0a8p1un4zs613b0brn1ctnf5g].[none:Calculation_2266411307458582:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Below 3.5 Stars (Poor)&quot;</bucket>
