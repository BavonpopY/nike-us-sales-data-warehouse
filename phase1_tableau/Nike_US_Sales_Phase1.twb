    <action caption='Highlight1' name='[Action4_5581E3B0C8D44FD1BB793CCFC636088A]'>
      <activation auto-clear='true' type='on-hover' />
      <source dashboard='DB1_Executive_Overview' type='sheet' worksheet='WS_Exec_Region_Channel_Matrix' />
