      <aliases enabled='yes' />
      <column caption='Brand Line' datatype='string' name='[Brand_Line]' role='dimension' type='nominal' />
      <column caption='Inv FY End Date' datatype='date' name='[Calculation_0825250504372291]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [Fiscal_Year] : MAX(IF NOT ISNULL([Units_On_Hand]) THEN [Full_Date] END)}' />
      </column>
      <column caption='Is FY End' datatype='boolean' name='[Calculation_0825250504425540]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Full_Date] = [Calculation_0825250504372291]' />
      </column>
      <column caption='K12 Ending On-Hand' datatype='integer' name='[Calculation_0825250504495173]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_0825250504425540] THEN [Units_On_Hand] END)' />
      </column>
      <column caption='K13 Ending Value' datatype='real' name='[Calculation_0825250504552518]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_0825250504425540] THEN [Inventory_Value_Cost] END)' />
      </column>
      <column caption='Weeks in FY' datatype='real' name='[Calculation_0825250504601671]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF NOT ISNULL([Units_On_Hand]) THEN [Full_Date] END) * 4.345' />
      </column>
      <column caption='K14 Weeks of Supply' datatype='real' name='[Calculation_0825250504675400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0825250504495173] / (SUM([Units_Shipped]) / [Calculation_0825250504601671])' />
      </column>
      <column caption='K15 Sell-Through %' datatype='real' name='[Calculation_0825250504888393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Units_Shipped]) / ([Calculation_0825250504495173] + SUM([Units_Shipped]))' />
      </column>
      <column caption='K16 Stock-out Days' datatype='integer' name='[Calculation_0825250504937546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Stockout_Days])' />
      </column>
      <column caption='Is Selected Month' datatype='boolean' name='[Calculation_0825250504978507]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Full_Date]) = DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 0825250490957825])' />
      </column>
      <column caption='Row Sell-Through' datatype='real' name='[Calculation_0825250505031756]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Units_Shipped] / ([Units_On_Hand] + [Units_Shipped])' />
      </column>
      <column caption='Stock Status' datatype='string' name='[Calculation_0825250505068621]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Weeks_Of_Supply]) THEN &apos;No movement&apos;&#13;&#10;ELSEIF [Weeks_Of_Supply] &lt; [Parameters].[Parameter 0825250491445253] THEN &apos;Stock-out risk&apos;&#13;&#10;ELSEIF [Weeks_Of_Supply] &gt; [Parameters].[Parameter 0825250491670534] THEN &apos;Overstock&apos;&#13;&#10;ELSE &apos;Healthy&apos; END' />
      </column>
      <column caption='EOL Rank' datatype='integer' name='[Calculation_0825250505224272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Inventory_Value_Cost]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Is Selected FY (Inv)' datatype='boolean' name='[Calculation_0825250571608149]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Fiscal_Year] = [Parameters].[Parameter 0825250489688064]' />
      </column>
      <column caption='EOL Top N' datatype='boolean' name='[Calculation_0825250574155862]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_0825250505224272] &lt;= [Parameters].[Parameter 0825250491195394]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
