              <range max='#2024-12-31#' min='#2020-01-01#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1nxobnf18c7t5212dpou115r1kzt'>
            <column caption='Net Sales CY' datatype='real' name='[Calculation_0825250496655382]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Fiscal_Year] = [Parameters].[Parameter 0825250489688064] THEN [Net_Sales_Amount] END)' />
            </column>
            <column caption='Profit CY' datatype='real' name='[Calculation_0825250496868377]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Fiscal_Year] = [Parameters].[Parameter 0825250489688064] THEN [Operating_Profit] END)' />
            </column>
            <column caption='Margin CY' datatype='real' default-format='p0.0%' name='[Calculation_0825250497011739]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0825250496868377] / [Calculation_0825250496655382]' />
            </column>
            <column caption='DTC Share CY' datatype='real' default-format='p0.0%' name='[Calculation_0825250497069084]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Fiscal_Year] = [Parameters].[Parameter 0825250489688064] AND [Ownership_Type] = &apos;Nike-Owned&apos;&#13;&#10;THEN [Net_Sales_Amount] END) / [Calculation_0825250496655382]' />
            </column>
            <column caption='Return Rate CY' datatype='real' default-format='p0.0%' name='[Calculation_0825250497171485]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Fiscal_Year] = [Parameters].[Parameter 0825250489688064] THEN [Units_Returned] END)&#13;&#10;/ SUM(IF [Fiscal_Year] = [Parameters].[Parameter 0825250489688064] THEN [Units_Sold] END)' />
            </column>
            <column caption='FY Start (As Of)' datatype='date' name='[Calculation_0825250497503262]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='MAKEDATE(IF MONTH([Parameters].[Parameter 0825250490957825]) &gt;= 6 THEN YEAR([Parameters].[Parameter 0825250490957825]) ELSE&#13;&#10;YEAR([Parameters].[Parameter 0825250490957825]) - 1 END, 6, 1)' />
            </column>
            <column caption='Is FYTD' datatype='boolean' name='[Calculation_0825250497601567]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Full_Date] &gt;= [Calculation_0825250497503262] AND [Full_Date] &lt;= [Parameters].[Parameter 0825250490957825]' />
            </column>
            <column caption='Is PY FYTD' datatype='boolean' name='[Calculation_0825250497658912]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Full_Date] &gt;= DATEADD(&apos;year&apos;, -1, [Calculation_0825250497503262])&#13;&#10;AND [Full_Date] &lt;= DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 0825250490957825])' />
            </column>
            <column caption='Net Sales PY FYTD' datatype='real' name='[Calculation_0825250497982497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_0825250497658912] THEN [Net_Sales_Amount] END)' />
            </column>
            <column caption='YoY % FYTD' datatype='real' default-format='p0.0%' name='[Calculation_0825250498134050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_0825250507346002] - [Calculation_0825250497982497]) / [Calculation_0825250497982497]' />
            </column>
            <column caption='Net Sales FYTD' datatype='real' name='[Calculation_0825250507346002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_0825250497601567] THEN [Net_Sales_Amount] END)' />
            </column>
