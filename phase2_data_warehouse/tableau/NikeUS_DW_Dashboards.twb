          <datasource-dependencies datasource='federated.1nxobnf18c7t5212dpou115r1kzt'>
            <column caption='Is MTD' datatype='boolean' name='[Calculation_0825250498379811]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Full_Date]) = DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 0825250490957825])&#13;&#10;AND [Full_Date] &lt;= [Parameters].[Parameter 0825250490957825]' />
            </column>
            <column caption='Is PY MTD' datatype='boolean' name='[Calculation_0825250498629668]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Full_Date]) = DATEADD(&apos;year&apos;, -1,&#13;&#10;DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 0825250490957825]))&#13;&#10;AND [Full_Date] &lt;= DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 0825250490957825])' />
            </column>
            <column caption='MTD Pace %' datatype='real' name='[Calculation_0825250498736165]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [Calculation_0825250498379811] THEN [Net_Sales_Amount] END) / SUM(IF [Calculation_0825250498629668] THEN&#13;&#10;[Net_Sales_Amount] END) - 1' />
