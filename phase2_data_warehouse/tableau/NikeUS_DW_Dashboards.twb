      <aliases enabled='yes' />
      <column caption='Brand Line' datatype='string' name='[Brand_Line]' role='dimension' type='nominal' />
      <column caption='K1 Net Sales' datatype='real' default-format='c&quot;฿&quot;#,##0;-&quot;฿&quot;#,##0' name='[Calculation_0825250492411913]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Net_Sales_Amount])' />
      </column>
      <column caption='K3 Operating Margin %' datatype='real' default-format='p0.0%' name='[Calculation_0825250492657675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Operating_Profit]) / SUM([Net_Sales_Amount])' />
      </column>
      <column caption='K8 Promo Discount Rate' datatype='real' default-format='p0.0%' name='[Calculation_0825250492870670]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Promo_Discount_Amount]) / SUM([Gross_Sales_Amount])' />
      </column>
      <column caption='K10 Unit Return Rate' datatype='real' default-format='p0.0%' name='[Calculation_0825250492968975]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Units_Returned]) / SUM([Units_Sold])' />
      </column>
      <column caption='K11 Return Leakage' datatype='real' default-format='p0.0%' name='[Calculation_0825250493042704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Return_Amount]) / SUM([Gross_Sales_Amount])' />
      </column>
      <column caption='K17 DQ Correction Rate' datatype='real' default-format='p0.0%' name='[Calculation_0825250493095953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([DQ_Issue_Codes]) / COUNT([Sales_Line_Key])' />
      </column>
      <column caption='Channel Display' datatype='string' name='[Calculation_0825250493145106]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Ownership_Type] = &apos;Nike-Owned&apos; THEN &apos;Nike Direct&apos; ELSE [Channel_Name] END' />
      </column>
      <column caption='Ownership Group' datatype='string' name='[Calculation_0825250493251603]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Ownership_Type] = &apos;Nike-Owned&apos; THEN &apos;Nike Direct (DTC)&apos;&#13;&#10;ELSEIF [Ownership_Type] = &apos;Wholesale Partner&apos; THEN &apos;Wholesale&apos; ELSE&apos;Unknown&apos; END' />
      </column>
      <column caption='Is Selected FY' datatype='boolean' name='[Calculation_0825250496589845]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Fiscal_Year] = [Parameters].[Parameter 0825250489688064]' />
      </column>
      <column caption='Net Sales CY' datatype='real' name='[Calculation_0825250496655382]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Fiscal_Year] = [Parameters].[Parameter 0825250489688064] THEN [Net_Sales_Amount] END)' />
      </column>
      <column caption='Net Sales PY' datatype='real' name='[Calculation_0825250496720919]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Fiscal_Year] = [Parameters].[Parameter 0825250489688064] - 1 THEN [Net_Sales_Amount] END)' />
      </column>
      <column caption='YoY % (param)' datatype='real' default-format='p0.0%' name='[Calculation_0825250496802840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_0825250496655382] - [Calculation_0825250496720919]) / [Calculation_0825250496720919]' />
      </column>
      <column caption='Profit CY' datatype='real' name='[Calculation_0825250496868377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Fiscal_Year] = [Parameters].[Parameter 0825250489688064] THEN [Operating_Profit] END)' />
      </column>
      <column caption='Profit PY' datatype='real' name='[Calculation_0825250496909338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Fiscal_Year] = [Parameters].[Parameter 0825250489688064] - 1 THEN [Operating_Profit] END)' />
      </column>
      <column caption='Margin CY' datatype='real' default-format='p0.0%' name='[Calculation_0825250497011739]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0825250496868377] / [Calculation_0825250496655382]' />
      </column>
      <column caption='DTC Share CY' datatype='real' default-format='p0.0%' name='[Calculation_0825250497069084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Fiscal_Year] = [Parameters].[Parameter 0825250489688064] AND [Ownership_Type] = &apos;Nike-Owned&apos;&#13;&#10;THEN [Net_Sales_Amount] END) / [Calculation_0825250496655382]' />
      </column>
      <column caption='Return Rate CY' datatype='real' default-format='p0.0%' name='[Calculation_0825250497171485]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Fiscal_Year] = [Parameters].[Parameter 0825250489688064] THEN [Units_Returned] END)&#13;&#10;/ SUM(IF [Fiscal_Year] = [Parameters].[Parameter 0825250489688064] THEN [Units_Sold] END)' />
      </column>
      <column caption='FY Start (As Of)' datatype='date' name='[Calculation_0825250497503262]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='MAKEDATE(IF MONTH([Parameters].[Parameter 0825250490957825]) &gt;= 6 THEN YEAR([Parameters].[Parameter 0825250490957825]) ELSE&#13;&#10;YEAR([Parameters].[Parameter 0825250490957825]) - 1 END, 6, 1)' />
      </column>
      <column caption='Is FYTD' datatype='boolean' name='[Calculation_0825250497601567]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Full_Date] &gt;= [Calculation_0825250497503262] AND [Full_Date] &lt;= [Parameters].[Parameter 0825250490957825]' />
      </column>
      <column caption='Is PY FYTD' datatype='boolean' name='[Calculation_0825250497658912]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Full_Date] &gt;= DATEADD(&apos;year&apos;, -1, [Calculation_0825250497503262])&#13;&#10;AND [Full_Date] &lt;= DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 0825250490957825])' />
      </column>
      <column caption='Net Sales PY FYTD' datatype='real' name='[Calculation_0825250497982497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_0825250497658912] THEN [Net_Sales_Amount] END)' />
      </column>
      <column caption='YoY % FYTD' datatype='real' default-format='p0.0%' name='[Calculation_0825250498134050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_0825250507346002] - [Calculation_0825250497982497]) / [Calculation_0825250497982497]' />
      </column>
      <column caption='Is MTD' datatype='boolean' name='[Calculation_0825250498379811]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Full_Date]) = DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 0825250490957825])&#13;&#10;AND [Full_Date] &lt;= [Parameters].[Parameter 0825250490957825]' />
      </column>
      <column caption='Is PY MTD' datatype='boolean' name='[Calculation_0825250498629668]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Full_Date]) = DATEADD(&apos;year&apos;, -1,&#13;&#10;DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 0825250490957825]))&#13;&#10;AND [Full_Date] &lt;= DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 0825250490957825])' />
      </column>
      <column caption='MTD Pace %' datatype='real' name='[Calculation_0825250498736165]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_0825250498379811] THEN [Net_Sales_Amount] END) / SUM(IF [Calculation_0825250498629668] THEN&#13;&#10;[Net_Sales_Amount] END) - 1' />
      </column>
      <column caption='Profit Delta (CY-PY)' datatype='real' name='[Calculation_0825250499031078]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0825250496868377] - [Calculation_0825250496909338]' />
      </column>
      <column caption='DTC Launch Date' datatype='date' name='[Calculation_0825250499084327]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='#2022-06-01#' />
      </column>
      <column caption='Franchise Net Sales CY' datatype='real' name='[Calculation_0825250499792936]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Franchise] : SUM(IF [Fiscal_Year] = [Parameters].[Parameter 0825250489688064] THEN [Net_Sales_Amount] END)}' />
      </column>
      <column caption='Franchise Net Sales PY' datatype='real' name='[Calculation_0825250499915817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Franchise] : SUM(IF [Fiscal_Year] = [Parameters].[Parameter 0825250489688064] - 1 THEN&#13;&#10;&#13;&#10;[Net_Sales_Amount] END)}' />
      </column>
      <column caption='Franchise Profit CY' datatype='real' name='[Calculation_0825250499997738]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Franchise] : SUM(IF [Fiscal_Year] = [Parameters].[Parameter 0825250489688064] THEN&#13;&#10;[Operating_Profit] END)}' />
      </column>
      <column caption='Franchise Growth FY' datatype='real' name='[Calculation_0825250500067371]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0825250499792936] / [Calculation_0825250499915817] - 1' />
      </column>
      <column caption='Franchise Margin' datatype='real' name='[Calculation_0825250500157484]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0825250499997738] / [Calculation_0825250499792936]' />
      </column>
      <column caption='Portfolio Avg Margin' datatype='real' name='[Calculation_0825250500259885]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : SUM(IF [Fiscal_Year] = [Parameters].[Parameter 0825250489688064] THEN [Operating_Profit] END)}&#13;&#10;/ {FIXED : SUM(IF [Fiscal_Year] = [Parameters].[Parameter 0825250489688064] THEN [Net_Sales_Amount] END)}' />
      </column>
      <column caption='Quadrant' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_0825250500386862]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0825250500067371] &gt;= 0 AND [Calculation_0825250500157484] &gt;= [Calculation_0825250500259885] THEN &apos;Scale up&apos;&#13;&#10;ELSEIF [Calculation_0825250500067371] &lt; 0 AND [Calculation_0825250500157484] &gt;= [Calculation_0825250500259885] THEN &apos;Protect margin&apos;&#13;&#10;ELSEIF [Calculation_0825250500067371] &gt;= 0 THEN &apos;Fix profitability&apos;&#13;&#10;ELSE &apos;Review / exit&apos; END' />
      </column>
      <column caption='Had FY23 Increase' datatype='integer' name='[Calculation_0825250500747311]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Product_ID] : MAX(IF STARTSWITH([Row_Change_Reason], &apos;FY23&apos;) THEN 1 ELSE 0 END)}' />
      </column>
      <column caption='Price Group' datatype='string' name='[Calculation_0825250500833328]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0825250500747311] = 1 THEN &apos;With FY23 price increase&apos; ELSE &apos;No FY23 increase&apos; END' />
      </column>
      <column caption='Baseline Units per Line' datatype='real' name='[Calculation_0825250500935729]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Channel_Name], [Year_Month] : AVG(IF [Promotion_Key] = 0 AND [Line_Type] = &apos;SALE&apos; THEN [Units_Sold] END)}' />
      </column>
      <column caption='Promo Line Uplift' datatype='real' name='[Calculation_0825250501095474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Promotion_Key] &gt; 0 AND [Line_Type] = &apos;SALE&apos; THEN [Units_Sold] / [Calculation_0825250500935729] - 1 END' />
      </column>
      <column caption='K9 Promo Unit Uplift %' datatype='real' name='[Calculation_0825250501161011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_0825250501095474])' />
      </column>
      <column caption='No-Promo Margin (Channel)' datatype='real' name='[Calculation_0825250501431348]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Channel_Name] : SUM(IF [Promotion_Key] = 0 THEN [Operating_Profit] END)&#13;&#10;/ SUM(IF [Promotion_Key] = 0 THEN [Net_Sales_Amount] END)}' />
      </column>
      <column caption='Margin Gap vs Baseline' datatype='real' name='[Calculation_0825250501959733]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0825250492657675] - AVG([Calculation_0825250501431348])' />
      </column>
      <column caption='Profit PY Total' datatype='real' name='[Calculation_0825250502127670]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : SUM(IF [Fiscal_Year] = [Parameters].[Parameter 0825250489688064] - 1 THEN [Operating_Profit] END)}' />
      </column>
      <column caption='YoY Growth % (TC)' datatype='real' default-format='p0.0%' name='[Calculation_0825250502279223]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Net_Sales_Amount])) - LOOKUP(ZN(SUM([Net_Sales_Amount])), -1))&#13;&#10;/ ABS(LOOKUP(ZN(SUM([Net_Sales_Amount])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Waterfall Running' datatype='real' name='[Calculation_0825250502565944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM([Calculation_0825250499031078]) + MIN([Calculation_0825250502127670])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Waterfall Size' datatype='real' name='[Calculation_0825250502631481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-[Calculation_0825250499031078]' />
      </column>
      <column caption='Sim Units Factor' datatype='real' name='[Calculation_0825250502705210]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 + [Parameters].[Parameter 0825250491977736] * [Parameters].[Parameter 0825250491809799]' />
      </column>
      <column caption='Sim Operating Profit' datatype='real' name='[Calculation_0825250502774843]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_0825250496868377] + [Calculation_0825250496655382] * [Parameters].[Parameter 0825250491809799]) * [Calculation_0825250502705210]' />
      </column>
      <column caption='Profit Gap' datatype='real' name='[Calculation_0825250502934588]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0825250502774843] - [Calculation_0825250496868377]' />
      </column>
      <column caption='ASP FY22' datatype='real' name='[Calculation_0825250502991933]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Fiscal_Year] = 2022 THEN [Gross_Sales_Amount] END) / SUM(IF&#13;&#10;&#13;&#10;[Fiscal_Year] = 2022 THEN [Units_Sold] END)' />
      </column>
      <column caption='ASP FY23' datatype='real' name='[Calculation_0825250503036990]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Fiscal_Year] = 2023 THEN [Gross_Sales_Amount] END) / SUM(IF&#13;&#10;&#13;&#10;[Fiscal_Year] = 2023 THEN [Units_Sold] END)' />
      </column>
      <column caption='ASP Change %' datatype='real' name='[Calculation_0825250503123007]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0825250503036990] / [Calculation_0825250502991933] - 1' />
      </column>
      <column caption='Units Change %' datatype='real' default-format='p0.0%' name='[Calculation_0825250503188544]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Fiscal_Year] = 2023 THEN [Units_Sold] END) / SUM(IF [Fiscal_Year] = 2022 THEN [Units_Sold] END) - 1' />
      </column>
      <column caption='Retail Event Label' datatype='string' name='[Calculation_0825250503360577]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF INT([Is_Retail_Event]) = 1 THEN &apos;★&apos; ELSE &apos;&apos; END' />
      </column>
      <column caption='Net Sales FYTD' datatype='real' name='[Calculation_0825250507346002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Calculation_0825250497601567] THEN [Net_Sales_Amount] END)' />
      </column>
      <column caption='Version End Capped' datatype='date' name='[Calculation_0825250562392147]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [Effective_End_Date (Dim_Retailer)] &gt; #2024-12-31# THEN #2024-12-31# ELSE [Effective_End_Date (Dim_Retailer)] END' />
      </column>
      <column caption='Version Days' datatype='integer' name='[Calculation_0825250562842708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Effective_Start_Date (Dim_Retailer)], [Calculation_0825250562392147]) + 1' />
      </column>
      <column caption='Calendar Year' datatype='integer' name='[Calendar_Year]' role='dimension' type='quantitative' />
      <column caption='Census Division' datatype='string' name='[Census_Division]' role='dimension' type='nominal' />
      <column caption='Census Region' datatype='string' name='[Census_Region]' role='dimension' type='nominal' />
