    <worksheet name='DB5_Risk_Matrix'>
      <table>
        <view>
          <datasources>
            <datasource caption='NikeUS Inventory' name='federated.1h03ar51qj51ld11auh7o15ex0br' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p As Of Date' datatype='date' name='[Parameter 0825250490957825]' param-domain-type='range' role='measure' type='quantitative' value='#2024-01-01#'>
              <calculation class='tableau' formula='#2024-01-01#' />
              <range max='#2024-12-31#' min='#2020-01-01#' />
            </column>
            <column caption='p WOS Low' datatype='real' name='[Parameter 0825250491445253]' param-domain-type='range' role='measure' type='quantitative' value='4.'>
              <calculation class='tableau' formula='4.' />
              <range max='8.0' min='1.0' />
            </column>
            <column caption='p WOS High' datatype='real' name='[Parameter 0825250491670534]' param-domain-type='range' role='measure' type='quantitative' value='26.'>
              <calculation class='tableau' formula='26.' />
              <range max='52.0' min='13.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1h03ar51qj51ld11auh7o15ex0br'>
            <column caption='Is Selected Month' datatype='boolean' name='[Calculation_0825250504978507]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Full_Date]) = DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 0825250490957825])' />
            </column>
            <column caption='Row Sell-Through' datatype='real' name='[Calculation_0825250505031756]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Units_Shipped] / ([Units_On_Hand] + [Units_Shipped])' />
            </column>
            <column caption='Stock Status' datatype='string' name='[Calculation_0825250505068621]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Weeks_Of_Supply]) THEN &apos;No movement&apos;&#13;&#10;ELSEIF [Weeks_Of_Supply] &lt; [Parameters].[Parameter 0825250491445253] THEN &apos;Stock-out risk&apos;&#13;&#10;ELSEIF [Weeks_Of_Supply] &gt; [Parameters].[Parameter 0825250491670534] THEN &apos;Overstock&apos;&#13;&#10;ELSE &apos;Healthy&apos; END' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column caption='Full Date' datatype='date' name='[Full_Date]' role='dimension' type='ordinal' />
